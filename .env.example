# =============================================================================
# Japan Tour Project — environment variables
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env` in the project root (same folder as README.md).
#    PowerShell:  Copy-Item .env.example .env
#    bash:        cp .env.example .env
# 2. Fill in secrets. `.env` is gitignored; never commit real keys.
# =============================================================================

# --- Required for Streamlit chatbot (app_japan_tour.py) ---
OPENAI_API_KEY=

# --- Optional: AI Hub CLI download (see DATA_SETUP.md) ---
AIHUB_APIKEY=

# --- Optional: Google Places API nearby recommendations ---
GOOGLE_MAPS_API_KEY=

# --- Optional: LangSmith when using LangChain under src/ ---
LANGSMITH_API_KEY=

# --- Optional: LangSmith project name (defaults to japantour in src/config.py) ---
#LANGCHAIN_PROJECT=japantour

# --- Optional: Django (backend/manage.py runserver) ---
#DJANGO_SECRET_KEY=change-me-in-production
#DJANGO_DEBUG=true
#DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
