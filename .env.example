# .env.example — 회사 .env 와 동일 키를 맞춥니다. 값은 회사 PC에서 복사하세요.

OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
# 식사 추천 최소 Google 평점 (미만·평점 없음은 제외, 기본 4)
MIN_MEAL_PLACE_RATING=4

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# DB (회사와 동일하게 유지)
DB_ENGINE=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=japantour
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# RAG: faiss(파일) | pgvector(DB)
VECTOR_BACKEND=pgvector

# 항공·기타 (필요 시)
INCHEONTRANSPORT_API_KEY=
JUSO_API_KEY=
